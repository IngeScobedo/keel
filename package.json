{
  "name": "keel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "spikes/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "bun run --filter './packages/*' test",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit && tsc -p packages/gui/tsconfig.tools.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "tokens": "bun scripts/design-tokens.ts",
    "tokens:check": "bun scripts/design-tokens.ts --check",
    "format": "biome format --write .",
    "docs:format": "prettier --write \"**/*.md\" \"!**/node_modules/**\"",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\"",
    "docs:validate-ddl": "bun scripts/validate-ddl.ts",
    "ddl:extract": "bun scripts/extract-ddl.ts",
    "ddl:check": "bun scripts/extract-ddl.ts --check",
    "bench:phase0": "bun scripts/bench-phase0.ts",
    "spike:sdk": "bun spikes/sdk-capabilities/src/claude-probe.ts",
    "spike:codex": "bun spikes/sdk-capabilities/src/codex-probe.ts",
    "clean": "rm -rf packages/*/dist spikes/*/dist packages/*/tsconfig.tsbuildinfo",
    "gui:dev": "bun run --cwd packages/core build && bun run --cwd packages/gui dev",
    "gui:build": "bun run --cwd packages/core build && bun run --cwd packages/gui build",
    "gui:e2e": "bun run --cwd packages/gui e2e",
    "gui:desktop": "bun run --cwd packages/core build && bun run --cwd packages/gui desktop",
    "gui:release": "bun run --cwd packages/core build && PATH=\"$HOME/.cargo/bin:$PATH\" bun run --cwd packages/gui desktop:build",
    "gui:app": "./packages/gui/src-tauri/target/release/keel-gui"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "^1.4.0",
    "markdownlint-cli2": "^0.20.0",
    "prettier": "^3.9.9",
    "sqlite-vec": "^0.1.9",
    "typescript": "^7.0.2"
  }
}
