{
  "name": "@keel/daemon",
  "version": "0.0.0",
  "private": true,
  "description": "Daemon de Keel: store SQLite (ADR-0004), protocolo IPC (ADR-0005), scheduler y adaptadores. TypeScript sobre Bun (ADR-0003).",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "bun test",
    "dev": "tsc -b --watch"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.295",
    "@keel/core": "workspace:*",
    "@keel/git": "workspace:*",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.4.3"
  },
  "keel": {
    "runtime": "bun",
    "dependsOn": [
      "@keel/core",
      "@keel/git"
    ]
  }
}
