{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/dist", "!**/*.tsbuildinfo", "!**/__fixtures__", "!**/fixtures"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Select", "Combobox", "Checkbox", "Switch", "Input", "TextArea"]
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "bun": "core es runtime-agnostico y sin I/O (ADR-0001 de Keel, hereda la regla de Mirador).",
                  "bun:sqlite": "core es runtime-agnostico: prohibido bun:*.",
                  "bun:test": "Los tests viven en test/, no en src/.",
                  "node:fs": "core no hace I/O.",
                  "node:child_process": "core no hace I/O."
                }
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "core es runtime-agnostico."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/git/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "bun": "Las librerías corren en Node (ADR-0007 §4).",
                  "bun:sqlite": "Las librerías corren en Node y no abren el store (ADR-0007 §1 y §4).",
                  "bun:test": "Los tests viven en test/, no en src/.",
                  "@keel/daemon": "Una librería no importa el producto (ADR-0007 §1).",
                  "@keel/gui": "Una librería no importa un cliente (ADR-0007 §1)."
                }
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "Las librerías corren en Node (ADR-0007 §4)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/gui/src/**", "!packages/gui/src/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@base-ui/**"],
                    "message": "Base UI sólo se importa en packages/gui/src/ui/: usa los componentes de Keel (ADR-0034 §2)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
