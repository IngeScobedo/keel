{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["packages/*/test/**/*.ts"],
  "references": [
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/daemon"
    },
    {
      "path": "./packages/gui"
    }
  ]
}
